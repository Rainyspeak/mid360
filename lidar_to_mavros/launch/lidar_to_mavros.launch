<launch>
<!-- Start your node -->
<include file="$(find livox_ros_driver2)/launch_ROS1/msg_MID360.launch"/>
<include file="$(find fast_lio)/launch/mapping_mid360.launch"/>
<node name="lidar_to_mavros" pkg="lidar_to_mavros" type="lidar_to_mavros" output="screen">
    <!-- 零漂校准: 开机后静止 N 秒, 记录位置漂移并扣除 -->
    <param name="zero_drift_calib_en"        type="bool"   value="true" />
    <param name="zero_drift_calib_time"      type="double" value="2.0" />
    <param name="zero_drift_motion_thresh"   type="double" value="0.05" />
    <!-- 雷达相对飞控的安装位置(飞控机体坐标系, 单位m): 向前为+, 向上为+ -->
    <!-- 杆臂补偿用飞控 IMU 姿态旋转, 自动适配雷达任意倾斜安装, 无需配置外参 -->
    <param name="lidar_offset_en"            type="bool"   value="true" />
    <param name="lidar_offset_x"             type="double" value="0.05" />
    <param name="lidar_offset_y"             type="double" value="0.0" />
    <param name="lidar_offset_z"             type="double" value="0.09" />
    <!-- 输出层位置EKF: 里程计(10Hz)更新+高频预测输出, 平滑阶梯位置并剔除野值; 姿态不受影响 -->
    <!-- 发布频率100Hz为上限: PX4 EKF2对外部视觉的有效带宽约30-50Hz -->
    <param name="publish_rate"               type="double" value="100.0" />
    <param name="kf_en"                      type="bool"   value="true" />
    <param name="kf_sigma_a"                 type="double" value="2.0" />   <!-- 过程噪声(m/s^2): 调小更平滑, 调大更紧跟测量 -->
    <param name="kf_sigma_r"                 type="double" value="0.03" />  <!-- 观测噪声(m): 里程计位置噪声水平 -->
    <param name="kf_gate_thresh"             type="double" value="11.35" /> <!-- 野值门限(3dof chi2: 95%=7.81, 99%=11.35) -->
    <param name="kf_max_rejects"             type="int"    value="15" />    <!-- 连续拒收上限, 超过后重置跟随真实大位移 -->
    <param name="kf_extrap_max"              type="double" value="0.5" />   <!-- 丢帧时最大外推时长(s) -->
</node>
</launch>
